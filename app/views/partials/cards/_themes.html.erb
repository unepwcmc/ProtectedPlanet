<% case local_assigns[:card_set]
   when :data_areas then get_data_areas
   when :thematic then get_thematic_areas
   else get_thematic_areas
   end %>

<div class="cards--themes container">
  <div class="cards__cards">
    <% @items[:cards].each do |card| %>
      <%= render partial: 'partials/sub_partials/themes', locals: { theme: card } %>
    <% end %>
  </div>
</div>