
<div class="vw-partials-cards-facts">
  <% cards.each do |card| %>
    <div class="vw-partials-cards-facts__card">
      <i class="vw-partials-cards-facts__pin vw-partials-cards-facts__pin--<%= card[:theme] %>">
        <%= render partial: 'partials/svgs/pin', formats: :svg %>
      </i>
      <span class="vw-partials-cards-facts__number-large">
        <%= card[:percentage] %>%
      </span>
      <% card[:totals].each do |total| %>
        <p class="vw-partials-cards-facts__total">
          <span class="vw-partials-cards-facts__number">
            <%= total[:number] %>:
          </span>
          <span class="vw-partials-cards-facts__text">
            <%= total[:text] %>
          </span>
        </p>
      <% end %>
      <p class="vw-partials-cards-facts__title">
        <%= card[:title] %>
      </p>
    </div>
  <% end %>
</div>