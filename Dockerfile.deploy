# ProtectedPlanet — production/staging image for Kamal 2.
#
# Ubuntu 24.04 (matching the host) for distro GDAL 3.8.4 and its built-in
# OpenFileGDB driver (rw+v, no ESRI SDK). See docs/GDAL-openfilegdb-migration.md.
# Ruby comes from ruby-build, not a ruby:* image: those are Debian-based and
# would not give us the 24.04 GDAL.

ARG RUBY_VERSION=3.3.7
ARG NODE_VERSION=26.8.1

# ---------------------------------------------------------------------------
# base — runtime libraries only, shared by build and final stages
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development:test" \
    RAILS_LOG_TO_STDOUT=1 \
    RAILS_SERVE_STATIC_FILES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl tzdata \
      # GDAL 3.8.4 + its geo stack. OpenFileGDB is built in — no ESRI SDK.
      gdal-bin libgdal34 libproj25 proj-data libgeos-c1v5 \
      # PostGIS client (pg gem) and spatialite. Noble's libpq 16 -- the PGDG 17 client
      # went with CountriesGeometryImporter (Sep 2026); nothing shells out to
      # psql/pg_dump here, and dump_schema_after_migration is false in staging/production.
      libpq5 libsqlite3-0 libspatialite8t64 \
      # psych/YAML; without the runtime .so Puma dies on libyaml-0.so.2.
      libyaml-0-2 \
      # Assets, .gdb download bundles, and Chrome's .zip — puppeteer needs
      # unzip or the download silently lands with no executable in it.
      shared-mime-info zip unzip \
      # Chromium runtime deps — the /country/*.pdf endpoint drives Puppeteer
      fonts-liberation libgtk-3-0t64 libcups2t64 libx11-xcb1 libxcomposite1 \
      libxdamage1 libxfixes3 libxrandr2 libgbm1 libnss3 libasound2t64 \
      libdrm2 libxkbcommon0 \
 && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# build — toolchain, Ruby, Node, gems, assets
# ---------------------------------------------------------------------------
FROM base AS build
ARG RUBY_VERSION
ARG NODE_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git pkg-config \
      autoconf bison libssl-dev libyaml-dev zlib1g-dev libreadline-dev \
      libffi-dev libgmp-dev libpq-dev libgdal-dev libsqlite3-dev \
      libxml2-dev libxslt1-dev xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Ruby via ruby-build
RUN git clone --depth 1 https://github.com/rbenv/ruby-build.git /tmp/ruby-build \
 && PREFIX=/usr/local /tmp/ruby-build/install.sh \
 && ruby-build "${RUBY_VERSION}" "/usr/local/ruby-${RUBY_VERSION}" \
 && rm -rf /tmp/ruby-build
ENV PATH="/usr/local/ruby-${RUBY_VERSION}/bin:${PATH}"

# Node from the official tarball. corepack comes from npm because Node 26
# unbundled it (a bare `corepack enable` exits 127 there); harmless on 24, and it
# keeps NODE_VERSION safe to bump. Yarn's version comes from package.json.
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz \
 && tar -xf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
 && rm /tmp/node.tar.xz \
 && npm install -g corepack@latest \
 && corepack enable

WORKDIR /app

# Gems first so the layer caches independently of app code
COPY Gemfile Gemfile.lock ./
RUN gem install bundler --no-document \
 && bundle config set --local without "${BUNDLE_WITHOUT}" \
 && bundle install --jobs 4 --retry 3 \
 && rm -rf "${BUNDLE_PATH}"/ruby/*/cache

# Then JS deps.
#
# PUPPETEER_CACHE_DIR must be inside /app: puppeteer 19+ keeps the browser under
# $HOME/.cache, and the runtime stage only copies /app.
ENV PUPPETEER_CACHE_DIR=/app/.cache/puppeteer

COPY package.json yarn.lock .yarnrc.yml* .puppeteerrc.cjs ./
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# PUPPETEER_SKIP_DOWNLOAD: puppeteer's postinstall has no retry, misses the build
# cache mount, and is what leaves the half-finished browser dir. Chrome is
# installed in its own step below instead.
RUN PUPPETEER_SKIP_DOWNLOAD=true yarn install --immutable \
 || PUPPETEER_SKIP_DOWNLOAD=true yarn install

COPY . .

# Asset build. SECRET_KEY_BASE_DUMMY lets Rails boot without a real key.
ARG RAILS_ENV=staging
ENV RAILS_ENV=${RAILS_ENV} \
    SECRET_KEY_BASE_DUMMY=1 \
    VITE_RUBY_VERBOSE=true

# vite_ruby derives its mode from RAILS_ENV, and `--mode staging` fails because
# config/vite.json defines only all/development/test. Pin the mode rather than
# inventing a staging section there.
ENV VITE_RUBY_MODE=production

# vite_ruby's precompile hook shells `yarn install --frozen-lockfile`, a Yarn 1
# flag Berry rejects — and the install already happened in its own cached layer.
ENV VITE_RUBY_SKIP_ASSETS_PRECOMPILE_INSTALL=true

# vite_rails boots the full app, which initialises the ActiveStorage S3 service.
# With AWS_S3_REGION unset, config/storage.yml passes region: nil and aws-sdk
# raises "missing region" (an explicit nil also defeats its AWS_REGION fallback).
# Build-time placeholder; the real value is injected at runtime.
#
# NB: separate ENV instruction on purpose — a comment inside a backslash-
# continued ENV breaks the continuation and the variable never gets set.
ENV AWS_S3_REGION=eu-west-1 \
    AWS_REGION=eu-west-1

# assets:precompile builds both pipelines — vite_rails enhances the task to run
# vite:build_all after sprockets — and every output is asserted afterwards.
# Its exit code is trusted: the enhancement's only failure path is `build ||
# exit!` on a genuine vite failure, so do not re-add a `|| echo` tolerance here.
#
# Sprockets owns only the Comfy CMS admin bundle now; the site CSS moved to
# Vite/Tailwind, so public/assets/application-*.css no longer exists.
#
# comfy:compile_assets must run FIRST. The gem ships an empty app/assets/builds/,
# and its esbuild/dart-sass admin sources are ones sprockets cannot compile; this
# task populates builds/ for assets:precompile to digest.
#
# The vite build MUST go through vite_ruby (the precompile enhancement, or rake
# vite:build_all), never ./node_modules/.bin/vite — only the Ruby entry point
# loads config/vite.rb, which sets the VITE_MAPBOX_TOKEN that vite.config.mts
# inlines into the bundle. Without it the map silently never renders.
#
# node_modules is PRUNED, not deleted: puppeteer is a runtime dependency, since
# both PDF paths shell out to backend-scripts/rasterize.js.
RUN --mount=type=secret,id=MAPBOX_ACCESS_TOKEN \
    export MAPBOX_ACCESS_TOKEN="$(cat /run/secrets/MAPBOX_ACCESS_TOKEN 2>/dev/null || true)" \
 && rm -rf public/assets public/vite tmp/cache/vite \
 && bundle exec rails comfy:compile_assets \
 && bundle exec rails assets:precompile \
 && test -s public/vite/.vite/manifest.json \
 && ls public/assets/comfy/admin/cms/application-*.css >/dev/null \
 && test "$(ls public/assets | wc -l)" -gt 10 \
 && (grep -rq "VITE_MAPBOX_TOKEN:\`\?pk\." public/vite/assets/ \
     || (echo "ERROR: no Mapbox token in the built bundle -- the map will not render. Is MAPBOX_ACCESS_TOKEN passed as a builder secret?" && exit 1)) \
 && echo "assets OK: $(ls public/assets | wc -l) sprockets, vite manifest + mapbox token present" \
 && PUPPETEER_SKIP_DOWNLOAD=true yarn workspaces focus --production \
 && rm -rf tmp/cache

# Chrome is reinstalled from scratch because yarn's postinstall reports success
# while leaving a version directory with no executable in it, which the CLI then
# refuses to repair ("already installed") and which surfaces much later as
# "Could not find Chrome".
#
# The cache mount is wiped only AFTER a failed attempt, so a good browser makes
# this a fast no-op. $PUPPETEER_CACHE_DIR is cleared every attempt — the `cp -a`
# repopulates it. verify-puppeteer.js is the hard gate; see that file.
RUN --mount=type=cache,target=/puppeteer-dl-cache \
    n=0; \
    until rm -rf "$PUPPETEER_CACHE_DIR" \
        && PUPPETEER_CACHE_DIR=/puppeteer-dl-cache ./node_modules/.bin/puppeteer browsers install chrome; do \
        n=$((n+1)); \
        if [ "$n" -ge 3 ]; then echo "Chrome download failed after 3 attempts" >&2; exit 1; fi; \
        echo "Chrome download attempt $n failed, clearing the cache and retrying in 5s..."; \
        find /puppeteer-dl-cache -mindepth 1 -delete; \
        sleep 5; \
    done \
 && mkdir -p "$PUPPETEER_CACHE_DIR" \
 && cp -a /puppeteer-dl-cache/. "$PUPPETEER_CACHE_DIR/" \
 && node app/frontend/backend-scripts/verify-puppeteer.js

# ---------------------------------------------------------------------------
# runtime
# ---------------------------------------------------------------------------
FROM base AS runtime
ARG RUBY_VERSION
ARG RAILS_ENV=staging
ENV PATH="/usr/local/ruby-${RUBY_VERSION}/bin:${PATH}"
# Build-stage ENV is not inherited. Puppeteer resolves the browser from this at
# runtime too, and config/puma.rb would otherwise default to development.
ENV PUPPETEER_CACHE_DIR=/app/.cache/puppeteer
ENV RAILS_ENV=${RAILS_ENV}

COPY --from=build /usr/local/ruby-${RUBY_VERSION} /usr/local/ruby-${RUBY_VERSION}
COPY --from=build ${BUNDLE_PATH} ${BUNDLE_PATH}
COPY --from=build /app /app

# A JS runtime is needed at BOOT, not just at build: terser and coffee-rails
# initialise ExecJS when Rails loads. Reuse the build stage's binary so the
# version matches.
COPY --from=build /usr/local/bin/node /usr/local/bin/node

WORKDIR /app

# Non-root. uid 1000 matches cloud-init's ownership of /data/pp-imports, so the
# Kamal volume is writable without a chown at boot.
RUN groupadd -g 1000 -r app 2>/dev/null || true \
 && useradd -u 1000 -g 1000 --create-home --shell /bin/bash app 2>/dev/null || true \
 && mkdir -p tmp/pids log storage \
 # entrypoint.sh is mode 644 in git, so set the bit here.
 && chmod +x entrypoint.sh bin/docker-sidekiq-healthcheck docker/scripts/pdf-chrome \
 && chown -R 1000:1000 /app
USER 1000:1000

EXPOSE 3000
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
