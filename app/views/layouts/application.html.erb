<!DOCTYPE html>
<html>
  <%= render "layouts/partials/head" %>
  <body class="<%= 'tw-global-pdf-export' if @for_pdf %>">
    <% unless @cms_page&.slug == PageSlugs::LEGAL %>
      <%= render "layouts/partials/cookie_consent" %>
    <% end %>
    <% unless @for_pdf %>
      <%= render "layouts/partials/banner" %>
    <% end %>
    <%= render "layouts/partials/topbar" %>
    <div class="vw-layouts-application">
      <%= yield %>
      <%= render "layouts/partials/footer/index" %>
    </div>
    <%= turbo_mount "DownloadModal", props: {
      endpointCreate: '/downloads',
      endpointPoll: '/downloads/poll',
      gaId: 'Download modal',
      textDownload: download_text[:download],
      textStatus: download_text[:status]
    } %>
  </body>
</html>
