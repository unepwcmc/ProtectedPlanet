<div class="vw-partials-bars-topbar-secondary">
  <div class="vw-partials-bars-topbar-secondary__container">
    <%= render "partials/social/social-share" %>
    <%= frontend_mount "Download",
            props: {
              buttonText: t('global.button.download'),
              options: JSON.parse(download_options),
              textCommercial: download_text[:commercial],
              downloadDisabled: local_assigns.has_key?(:download_disabled) ? download_disabled : false,
              gaId: 'download',
              compact: true
            } %>
  </div>
</div>
