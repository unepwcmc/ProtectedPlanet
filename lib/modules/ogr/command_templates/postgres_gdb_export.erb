ogr2ogr 
<% if needs_updating %>
  -update
<% end %>
-skipfailures
-f "<%= Ogr::Postgres::DRIVERS[:gdb] %>"
<%= file_name %>
PG:"host=<%= db_config[:host] %>
  user=<%= db_config[:username] %> 
  <% unless db_config[:password].nil? %>
    password=<%= db_config[:password] %>
  <% end %>
  dbname=<%= db_config[:database] %>"
  <%# For query we need to use '' instead of "" to avoid shell escaping %>
-sql '<%= query %>'
<% unless geom_type == 'source' %>
  -nlt "<%= geom_type.upcase %>"
<% end %>
<%# OpenFileGDB names the geometry column after the source (the_geom); the Esri FileGDB
    SDK named it SHAPE. Force SHAPE so the .gdb schema is identical to the old output. %>
-lco "GEOMETRY_NAME=SHAPE"
-nln "<%= feature_name %>"
