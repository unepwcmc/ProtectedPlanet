<div class="vw-partials-charts-chart-legends vw-partials-charts-chart-legend--<%= variant %>">
  <% rows.each do |row| %>
    <div class="vw-partials-charts-chart-legend__item vw-partials-charts-chart-legend__item--<%= variant %>">
      <span class="vw-partials-charts-chart-legend__key vw-partials-charts-chart-legend__key--<%= variant %>-<%= row[:theme] %>"></span>
      <span class="vw-partials-charts-chart-legend__title vw-partials-charts-chart-legend__title--<%= variant %>"><%= row[:title] %></span>
    </div>
  <% end %>
</div>
