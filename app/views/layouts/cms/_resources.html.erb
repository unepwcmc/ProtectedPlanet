<%= render partial: "./layouts/partials/hero/small", locals: {
  image: cms_fragment_render(:image, @cms_page),
  title: @cms_page.label
} %>
<%= frontend_mount "Listing", props: {
  endpointSearch: search_cms_path,
  filterGroups: get_category_filters,
  gaId: "Slug: #{@cms_page.slug}",
  itemsPerPage: 9,
  pageId: @cms_page.id,
  results: cms_pages_for_search,
  template: "resources",
  textClear: t('search.clear'),
  textFiltersClose: "View Results",
  textFilterTrigger: t('search.filters'),
  textNoResults: "No Results"
} %>
<%= render "partials/ctas/live-report" %>