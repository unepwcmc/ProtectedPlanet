<% extras = thematic_and_data_area_tab_extras_config(tab, tab_extras) %>
<% if extras %>
  <%= render partial: extras[:partial], locals: extras.fetch(:locals, {}).merge(tab: tab) %>
<% else %>
  <div class="vw-thematic-and-data-area-panel-content__container">
    <%= cms_fragment_render(tab[:content_id]) %>
  </div>
<% end %>
