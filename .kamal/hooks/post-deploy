#!/usr/bin/env bash
set -euo pipefail

# Flush the cache after the new containers are live.
#
# WHAT THIS IS FOR NOW:
# Rails.cache holds derived data with long TTLs -- country and region statistics and
# totals, the marine figures, blank-term search aggregations, Mapbox tiles. Most of
# those keys carry the release label, so a data release gets fresh entries on its
# own, but a code deploy that changes how a figure is DERIVED does not. This flush
# covers that case.
#
# It used to be load-bearing for a different reason: Rack::Cache stored rendered HTML
# in the same memcached, that HTML embedded digest-stamped asset paths
# (/vite/assets/application-<hash>.js), and every build deletes the files the old
# digests point at -- so skipping the flush left the site rendering but inert. That
# cannot happen any more: there is no shared HTML cache (see ApplicationController),
# so every page is rendered fresh and always names the current build's assets.
#
# NB: Rails.cache.clear issues Dalli's flush_all, which clears the WHOLE memcached
# instance. Today only ProtectedPlanet points at this host's memcached (verified: no
# other container defines MEMCACHE_*). If another app is ever pointed at it, give it
# its own instance rather than making this flush narrower.
#
# --primary --roles web for the same reason as pre-deploy: `app exec` otherwise
# fans out to every role and runs this once per role.

echo "==> Flushing cache after deploy of ${KAMAL_VERSION} (destination: ${KAMAL_DESTINATION:-none})"

if kamal app exec \
     ${KAMAL_DESTINATION:+--destination "$KAMAL_DESTINATION"} \
     --primary \
     --roles web \
     --version "$KAMAL_VERSION" \
     "bundle exec rails runner 'Rails.cache.clear'"; then
  echo "==> Cache flushed"
else
  # The containers are already live at this point, so this cannot roll anything
  # back. No longer fatal to the site -- pages render fresh either way -- but still
  # loud, because stale derived figures are the kind of wrong that nobody reports.
  echo "!!! CACHE FLUSH FAILED — derived figures (statistics, totals, search"
  echo "!!! aggregations, tiles) may still be the previous build's. Pages themselves"
  echo "!!! are unaffected: nothing caches rendered HTML."
  echo "!!! Flush manually, e.g.:"
  echo "!!!   kamal app exec --primary --roles web \"bundle exec rails runner 'Rails.cache.clear'\""
  exit 1
fi

# ---------------------------------------------------------------------------
# Walk every GET route against the containers that just went live.
#
# WHY THIS IS HERE AND NOT IN pre-deploy:
# pre-deploy runs migrations, so a blocking gate there could abort with staging
# left on a migrated database and the OLD code still serving -- worse than the bug
# it caught. This cannot block (traffic already cut over), so it exists to make a
# bad deploy LOUD rather than something found by clicking around days later.
# Kamal does not roll back on hook failure; the rollback command is printed below.
#
# WHY NOT A LOCAL PRE-PUSH GATE INSTEAD:
# it would be green for the failures that actually cost deploy cycles. Local
# docker-compose runs postgis:11.5 against staging's PG 17, with a different .env
# and different CMS content -- so the PG17 date_part/extract rename, the unset
# MAPBOX_STATIC_IMAGE_URL that 500'd every tile, and the search-cms failure would
# all have passed locally. Anything local CAN see is already caught by the test
# suite and bin/preflight-deploy steps 5-8.
#
# AFTER the cache flush, deliberately: a walk before it would grade pages built from
# the previous build's derived figures rather than this one's.

# The scheme is explicit and MUST stay https. PP_HOST (config/deploy.staging.yml)
# is a bare hostname; over http kamal-proxy 301s every route, and the walker counts
# 3xx as healthy -- the smoke would report "37 healthy" having tested nothing.
SMOKE_BASE_URL="https://pp-web-staging-01.internal.unep-wcmc.org"

if [[ "${KAMAL_DESTINATION:-}" != "staging" ]]; then
  echo "==> Skipping route smoke (no BASE_URL known for destination '${KAMAL_DESTINATION:-none}')"
  exit 0
fi

echo "==> Walking routes against ${SMOKE_BASE_URL}"

# Runs in a one-off container rather than `--reuse`, so this does not depend on a
# kamal version that supports reusing the running container, and does not need the
# live container's name (Kamal appends a hash to it). The task needs Rails loaded to
# read real fixture ids -- a protected area, country isos, CMS page paths -- out of
# the database before it walks, and that is the SAME database serving SMOKE_BASE_URL,
# which is the condition the task's own docs require before pointing it at a hostname.
if kamal app exec \
     --destination "$KAMAL_DESTINATION" \
     --primary \
     --roles web \
     --version "$KAMAL_VERSION" \
     "bash -lc 'BASE_URL=${SMOKE_BASE_URL} bundle exec rake smoke:routes'"; then
  echo "==> Route smoke passed"
else
  echo "!!! ROUTE SMOKE FAILED — ${KAMAL_VERSION} is live and serving at least one broken route."
  echo "!!! The walker's FAILURES section is above; a route listed UNCLASSIFIED means a new"
  echo "!!! GET route shipped with no resolver and no skip reason, so it went out untested."
  echo "!!!"
  echo "!!! Kamal does NOT roll back on hook failure. To go back to the previous version:"
  echo "!!!   kamal rollback --destination ${KAMAL_DESTINATION}"
  exit 1
fi
