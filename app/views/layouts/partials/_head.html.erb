 <head>
  <meta charset="utf-8">
  <title>
    <%= page_title %>
  </title>
  <meta name="description" content="<%= page_description %>">
  <%== opengraph %>
  <% if canonical_url %>
    <link rel="canonical" href="<%= canonical_url %>">
  <% end %>
  <% if structured_data %>
    <script type="application/ld+json">
      <%== ERB::Util.json_escape(structured_data.to_json) %>
    </script>
  <% end %>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% unless Rails.env.development? %>
    <meta http-equiv="Content-Security-Policy" content="<%=
      [
        "default-src 'self'",
        "script-src 'self' https://www.googletagmanager.com https://*.hotjar.com https://*.hotjar.io",
        "style-src 'self' 'unsafe-inline'",
        "img-src 'self' data: blob: https:",
        "font-src 'self' data:",
        "connect-src 'self' https:",
        "frame-src https://*.hotjar.com",
        "object-src 'none'",
        "base-uri 'self'",
        'upgrade-insecure-requests'
      ].join('; ')
    %>">
  <% end %>
  <link rel="manifest" href="/manifest.json">
  <%= csrf_meta_tags %>
  <%= vite_client_tag %>
  <%= vite_stylesheet_tag 'vitecss.css' %>
  <%= vite_typescript_tag 'application.ts' %>
</head>