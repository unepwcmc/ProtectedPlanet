<div class="vw-layouts-cms-about">
  <%= render partial: "./layouts/partials/hero/small", locals: { 
    classes: @cms_page.slug,
    image: cms_fragment_render(:image, @cms_page),
    title: @cms_page.label,  
  } %>
  <div class="vw-layouts-cms-about__container--medium">
    <section class="vw-layouts-cms-about__content">
      <%= cms_fragment_render("content") %>
    </section>
  </div>
  <%= render "partials/carousels/themes" %>
  <div class="vw-layouts-cms-about__container">
    <%= render "partials/cards/resources" %>
  </div>
  <%= render "partials/ctas/protected-planet-report" %>
</div>
