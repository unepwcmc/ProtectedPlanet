<% preview = local_assigns.has_key? :url %>
<% if preview %>
  <div class="vw-cards-sites__header">
    <h2 class="vw-cards-sites__title">
      <%= title %>
    </h2>
    <%= link_to t('global.button.all'), url, title: t('global.button.all'), class: "vw-cards-sites__view-all" %>
  </div>
<% end %>
<div class="vw-cards-sites__grid <%= 'vw-cards-sites__grid--preview' if preview %>">
  <% cards.each do |card| %>
    <%= link_to protected_area_path(card.site_id), title: "View more about the site: #{ card.name }", class: "vw-cards-sites__link" do %>
      <div class="vw-cards-sites__image-placeholder">
        <div alt="title" class="vw-cards-sites__image" style="background-image: url(<%= protected_area_cover(card, with_tag: false) %>)"></div>
      </div>
      <span class="vw-cards-sites__card-title">
        <%= card.name %>
      </span>
    <% end %>
  <% end %>
</div>
