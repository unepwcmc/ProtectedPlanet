<div class="vw-layouts-error-page">
  <% if Rails.env.development? %>
    <p class="vw-layouts-error-page__dev-notice">
      Dev mode: comment out <code>rescue_from StandardError</code> or <code>rescue_from PageNotFound</code> in
      <code>application_controller.rb</code> temporarily to see Rails' real error page instead of this one.
    </p>
  <% end %>
  <%= render partial: "layouts/partials/hero/basic", locals: {
      title: error_status == 404 ? t('global.redirect.title') : t('global.redirect.alt_title'),
      summary: t('global.redirect.text', url: root_url).html_safe,
      items_centre: true,
      centre_text: true
  } %>
  <div class="vw-layouts-error-page__container">
    <%= render "partials/cards/news" %>
    <%= render "partials/cards/resources" %>
  </div>
  <%= render "partials/carousels/themes" %>
  <%= render "partials/ctas/protected-planet-report" %>
</div>