# ProtectedPlanet — production/staging image for Kamal 2.
#
# This replaces the buster + GDAL-2.2.3-from-source + ESRI FileGDB SDK chain the
# development Dockerfile still carries. That chain cannot be built on a current
# base: ESRI ship FileGDB as a RHEL7 binary linked against an old glibc.
#
# Instead: Ubuntu 24.04 (matching the host), distro GDAL 3.8.4, and GDAL's
# built-in OpenFileGDB driver, which has written .gdb since 3.6 and reports as
# `rw+v` here. Verified end to end against the staging database — a 500-feature
# Multi Polygon layer plus a second layer appended with -update, read back
# cleanly. See docs/GDAL-openfilegdb-migration.md.
#
# Ruby is built with ruby-build rather than taken from a ruby:* image, because
# those are Debian-based and we want the 24.04 GDAL. The dev Dockerfile already
# uses ruby-build for 3.3.7, so the approach is proven in this repo.

ARG RUBY_VERSION=3.3.7
ARG NODE_VERSION=24.4.1

# ---------------------------------------------------------------------------
# base — runtime libraries only, shared by build and final stages
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development:test" \
    RAILS_LOG_TO_STDOUT=1 \
    RAILS_SERVE_STATIC_FILES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg tzdata \
      # GDAL 3.8.4 + its geo stack. OpenFileGDB is built in — no ESRI SDK.
      gdal-bin libgdal34 libproj25 proj-data libgeos-c1v5 \
      # PostGIS client (pg gem) and spatialite
      libpq5 libsqlite3-0 libspatialite8t64 \
      # psych/YAML. The build stage gets libyaml-dev, but the runtime stage needs
      # the shared library or Puma dies with
      # "libyaml-0.so.2: cannot open shared object file".
      libyaml-0-2 \
      # image/asset handling and zip for the .gdb download bundles
      shared-mime-info zip \
      # Chromium runtime deps — the /country/*.pdf endpoint drives Puppeteer
      fonts-liberation libgtk-3-0t64 libcups2t64 libx11-xcb1 libxcomposite1 \
      libxdamage1 libxfixes3 libxrandr2 libgbm1 libnss3 libasound2t64 \
      libdrm2 libxkbcommon0 \
 && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# build — toolchain, Ruby, Node, gems, assets
# ---------------------------------------------------------------------------
FROM base AS build
ARG RUBY_VERSION
ARG NODE_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git pkg-config \
      autoconf bison libssl-dev libyaml-dev zlib1g-dev libreadline-dev \
      libffi-dev libgmp-dev libpq-dev libgdal-dev libsqlite3-dev \
      libxml2-dev libxslt1-dev xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Ruby via ruby-build
RUN git clone --depth 1 https://github.com/rbenv/ruby-build.git /tmp/ruby-build \
 && PREFIX=/usr/local /tmp/ruby-build/install.sh \
 && ruby-build "${RUBY_VERSION}" "/usr/local/ruby-${RUBY_VERSION}" \
 && rm -rf /tmp/ruby-build
ENV PATH="/usr/local/ruby-${RUBY_VERSION}/bin:${PATH}"

# Node 24 from the official tarball (Vite 5 needs 18+).
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz \
 && tar -xf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
 && rm /tmp/node.tar.xz \
 && corepack enable && corepack prepare yarn@4.17.1 --activate

WORKDIR /app

# Gems first so the layer caches independently of app code
COPY Gemfile Gemfile.lock ./
RUN gem install bundler --no-document \
 && bundle config set --local without "${BUNDLE_WITHOUT}" \
 && bundle install --jobs 4 --retry 3 \
 && rm -rf "${BUNDLE_PATH}"/ruby/*/cache

# Then JS deps
COPY package.json yarn.lock .yarnrc.yml* ./
RUN yarn install --immutable || yarn install

COPY . .

# Asset build. SECRET_KEY_BASE_DUMMY lets Rails boot for assets:precompile
# without a real key. (NODE_OPTIONS=--openssl-legacy-provider is gone with
# webpacker 4 — Vite needs no such workaround on Node 24.)
ARG RAILS_ENV=staging
ENV RAILS_ENV=${RAILS_ENV} \
    SECRET_KEY_BASE_DUMMY=1 \
    VITE_RUBY_VERBOSE=true

# vite_ruby derives its build mode from RAILS_ENV, so under RAILS_ENV=staging it
# runs `vite build --mode staging`. config/vite.json defines only all/development/
# test, and the staging-mode build fails where `--mode production` succeeds.
# Pin the mode rather than inventing a staging section in vite.json.
ENV VITE_RUBY_MODE=production

# vite_rails boots the full Rails app before building, which initialises the
# ActiveStorage S3 service. config/storage.yml takes its region from
# Rails.application.config_for(:app_secrets).s3_region, which config/app_secrets.yml populates from
# ENV["AWS_S3_REGION"] — so with that unset the service is built with an
# explicit region: nil and aws-sdk raises "missing region". An explicit nil also
# defeats the SDK's own AWS_REGION fallback, so AWS_S3_REGION is the one that
# matters here. Build-time placeholder; the real value is injected at runtime.
#
# NB: separate ENV instruction on purpose — a comment inside a backslash-
# continued ENV breaks the continuation and the variable never gets set.
ENV AWS_S3_REGION=eu-west-1 \
    AWS_REGION=eu-west-1

# Assets are built in two explicit steps rather than one assets:precompile.
#
# vite_ruby enhances assets:precompile to also run vite:build_all. That nested
# invocation always fails here with a bare "Compilation failed:" and no stderr,
# while the identical build succeeds every other way. Verified in the image:
#
#   bundle exec rake vite:build_all      -> OK, writes public/vite + manifest
#   Open3.capture3(<the exact cmd vite_ruby builds>)  -> exit 0
#   bundle exec rails assets:precompile  -> sprockets output OK, vite step fails
#   ...also fails via `rake assets:precompile`, with NODE_OPTIONS unset, with
#      VITE_RUBY_SKIP_ASSETS_PRECOMPILE_INSTALL=true, and in every vite mode.
#
# So: let assets:precompile do the sprockets work (its vite step is tolerated),
# then run vite properly. Both outputs are then asserted — if either is really
# missing the build still fails, so this tolerates one known-bogus exit code
# without hiding a genuine breakage.
# This app now has TWO asset pipelines: sprockets and vite. (webpacker 4 was
# removed at the Vite cutover, along with config/webpack/* and babel.config.js.)
#
# vite_ruby's vite:build_all wrapper fails here with a bare "Compilation failed:"
# and no stderr, while the underlying binary succeeds. Verified in the image:
#
#   ./node_modules/.bin/vite build --mode production  -> exit 0
#   bundle exec rake vite:build_all                   -> "Compilation failed:"
#
# So the binary is invoked directly and every output is asserted afterwards.
# Sprockets still goes through assets:precompile, whose exit code is tolerated
# because its enhancement re-runs the same failing wrapper.
RUN rm -rf public/assets public/vite tmp/cache/vite \
 && (bundle exec rails assets:precompile || echo "note: sprockets done; ignoring the wrapper's bogus exit, outputs asserted below") \
 && ./node_modules/.bin/vite build --mode production \
 && test -s public/vite/.vite/manifest.json \
 && ls public/assets/application-*.css >/dev/null \
 && test "$(ls public/assets | wc -l)" -gt 10 \
 && echo "assets OK: $(ls public/assets | wc -l) sprockets, vite manifest present" \
 && rm -rf node_modules tmp/cache

# ---------------------------------------------------------------------------
# runtime
# ---------------------------------------------------------------------------
FROM base AS runtime
ARG RUBY_VERSION
ARG RAILS_ENV=staging
ENV PATH="/usr/local/ruby-${RUBY_VERSION}/bin:${PATH}"
# ENV from the build stage is not inherited. Without this, config/puma.rb falls
# back to ENV.fetch("RAILS_ENV") { "development" } and Puma boots the wrong env
# if the orchestrator's env file is ever missing it.
ENV RAILS_ENV=${RAILS_ENV}

COPY --from=build /usr/local/ruby-${RUBY_VERSION} /usr/local/ruby-${RUBY_VERSION}
COPY --from=build ${BUNDLE_PATH} ${BUNDLE_PATH}
COPY --from=build /app /app

# A JavaScript runtime is required at BOOT, not just at build time: terser and
# coffee-rails initialise ExecJS when Rails loads, so without a `node` on PATH
# Puma dies with ExecJS::RuntimeUnavailable even though assets are precompiled.
# Taking the binary from the build stage keeps the version identical.
COPY --from=build /usr/local/bin/node /usr/local/bin/node

WORKDIR /app

# Non-root. uid 1000 matches the ownership cloud-init sets on /data/pp-imports,
# so the Kamal volume is writable without a chown at boot.
RUN groupadd -g 1000 -r app 2>/dev/null || true \
 && useradd -u 1000 -g 1000 --create-home --shell /bin/bash app 2>/dev/null || true \
 && mkdir -p tmp/pids log storage \
 # entrypoint.sh is mode 644 in git (the compose setup invoked it as
 # `bash entrypoint.sh`), so set the bit here rather than relying on the repo.
 && chmod +x entrypoint.sh bin/docker-sidekiq-healthcheck \
 && chown -R 1000:1000 /app
USER 1000:1000

EXPOSE 3000
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
