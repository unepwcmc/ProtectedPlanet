<% if cta_api %>
  <section class="vw-partials-ctas-api">
    <div class="vw-partials-ctas-api__container">
      <div class="vw-partials-ctas-api__content">
        <h2 class="vw-partials-ctas-api__title">
          <%= cta_api.title %>
        </h2>
        <p class="vw-partials-ctas-api__intro">
          <%= cta_api.summary %>
        </p>
        <%= link_to t('ctas.api.button'), cta_api.url, target: '_blank', class: 'vw-partials-ctas-api__button' %>
      </div>
    </div>
    <%= image_tag 'icons/key.svg', alt: 'key icon', class: 'vw-partials-ctas-api__key' %>
  </section>
<% end %>