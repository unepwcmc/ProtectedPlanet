<%= link_to root_url + theme[:obj][:full_path],
  title: "View the #{theme[:obj][:label]} page",
  class: "vw-cards-themes-card",
  style: "background-image: url('#{cms_fragment_render(:image, theme[:obj])}')" do %>
  <div class="vw-cards-themes-card__overlay"></div>
  <% unless theme[:pas_no] == -1 %>
    <div class="vw-cards-themes-card__ribbon">
      <i class="vw-cards-themes-card__pin">
        <%= render '/partials/svgs/pin.svg' %>
      </i>
      <div class="vw-cards-themes-card__ribbon-details">
        <span class="vw-cards-themes-card__number"><%= theme[:pas_no] %></span>
        <span class="vw-cards-themes-card__number-text"><%= t('global.area-types.wdpca') %></span>
      </div>
    </div>
  <% end %>
  <h3 class="vw-cards-themes-card__title"><%= theme[:obj][:label] %></h3>
  <p class="vw-cards-themes-card__summary"><%= cms_fragment_content(:summary, theme[:obj]) %></p>
  <i class="vw-cards-themes-card__arrow"></i>
<% end %>
