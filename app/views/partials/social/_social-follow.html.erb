<div class="vw-partials-social-follow">
  <h3 class="vw-partials-social-follow__title">
    <%= t('global.footer.follow-us') %>
  </h3>
  <div class="vw-partials-social-follow__icons">
    <%  t('social.follow').keys.map(&:to_s).each do |slug| %>
      <%= link_to '', t("social.follow.#{slug}.url"),
          title: t("social.follow.#{slug}.title"),
          class: "vw-partials-social-follow__icon vw-partials-social-follow__icon--#{slug}",
          target: '_blank'
      %>
    <% end %>
  </div>
</div>