<div class="vw-layouts-cms-resource">
  <div class="vw-layouts-cms-resource__header">
    <p class="vw-layouts-cms-resource__date">
      <%= cms_fragment_content_datetime(:published_date, @cms_page).strftime('%d %B %y') %>
    </p>
    <h1 class="vw-layouts-cms-resource__title">
      <%= @cms_page.label %>
    </h1>
  </div>
  <section class="vw-layouts-cms-resource__content">
    <%= cms_fragment_render("content") %>
  </section>
  <section class="vw-layouts-cms-resource__links">
    <% unless get_resource_links.empty? %>
      <ul class="vw-layouts-cms-resource__links-list">
        <% get_resource_links.each do |link| %>
          <% unless link[:url].blank? %>
            <li class="vw-layouts-cms-resource__links-item">
              <span>
                <%= link[:text] %>
              </span>
              <%= link_to link[:url], title: link[:text], target: '_blank', class: 'vw-layouts-cms-resource__external-link' do %>
                <%= link[:button] %>
                <i class="vw-layouts-cms-resource__external-link--icon"></i>
              <% end %>
            </li>
          <% end %>
        <% end %>
      </ul>
    <% end %>
  </section>
  <div class="vw-layouts-cms-resource__socials">
    <%= render "partials/social/social-share" %>
  </div>
  <section class="vw-layouts-cms-resource__resources">
    <%= render "partials/cards/resources" %>
  </section>
  <%= render "partials/ctas/protected-planet-report" %>
</div>
