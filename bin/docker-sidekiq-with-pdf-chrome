#!/bin/bash
set -e

# Sidekiq plus the long-lived shared Chrome that the `pdf` capsule's jobs render
# in. Used as the container command by BOTH the compose `sidekiq` service and the
# Kamal `job_default` role, so the two cannot drift.
#
# Chrome has to live in the SAME container as the workers, not in an accessory of
# its own: rasterize.js connects to http://127.0.0.1:$PDF_BROWSER_PORT, and
# Chrome's DevTools endpoint refuses requests whose Host header is not
# localhost/an IP (DNS-rebinding protection), so a sibling container is reachable
# neither by address nor by name without a socat shim in front of it.
#
# Only the role running the `pdf` queue needs this. That queue is a capsule in
# config/sidekiq.yml (job_default); config/sidekiq-import.yml (job_import) never
# rasterizes, and neither does the web role - nothing outside
# Download::Generators::Pdf shells out to rasterize.js.
#
# Chrome is a best-effort optimisation, never a dependency: if it fails to start
# or dies later, rasterize.js just launches a private browser per job - slower and
# ~440MB heavier each, but not broken. So this script must not let a Chrome
# problem stop Sidekiq from booting.

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Where Chrome's own output goes. Unset (the deployment default) means stdout, so
# it lands in `kamal app logs` alongside everything else; the prefix keeps it
# distinguishable from Sidekiq's lines. Set PDF_CHROME_LOG to a path to split it
# out into a file instead (compose does, to keep the dev logs readable).
if [ -n "${PDF_CHROME_LOG}" ]; then
  "$APP_ROOT/docker/scripts/pdf-chrome" >> "${PDF_CHROME_LOG}" 2>&1 &
else
  "$APP_ROOT/docker/scripts/pdf-chrome" 2>&1 | sed -u 's/^/[pdf-chrome] /' &
fi

# `exec`, so Sidekiq - not this shell - is the process that receives the
# container's SIGTERM and gets to shut down gracefully. Chrome is left as an
# orphan inside the container and goes away with it.
#
# Args default to plain `bundle exec sidekiq` (what compose wants); Kamal passes
# `-C config/sidekiq.yml` explicitly.
if [ "$#" -gt 0 ]; then
  exec "$@"
else
  exec bundle exec sidekiq
fi
