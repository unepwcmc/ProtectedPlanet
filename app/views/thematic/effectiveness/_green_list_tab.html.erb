<div class="vw-thematic-effectiveness-green-list-tab">
  <div class="vw-thematic-effectiveness-green-list-tab__container">
    <div class="vw-thematic-effectiveness-green-list-tab__banner">
      <%= render partial: "layouts/partials/hero/green-list", 
          locals: green_list_banner_locals(@cms_page) %>
    </div>
    <section class="vw-thematic-effectiveness-green-list-tab__about">
      <h2 class="vw-thematic-effectiveness-green-list-tab__about-title">
        <%= cms_fragment_render(:green_list_about_title, @cms_page) %>
      </h2>
      <div class="vw-thematic-effectiveness-green-list-tab__about-content">
        <%= cms_fragment_render(:green_list_about_content, @cms_page) %>
      </div>
    </section>
    <%= render partial: "partials/charts/total-coverage-chart", locals: {
        charts: [{ charts_data: total_coverage_chart_data }],
        title: cms_fragment_render(:green_list_percentage_chart_title, @cms_page),
        content: cms_fragment_render(:green_list_percentage_chart_description, @cms_page)
      } %>
  </div>
  <section class="vw-thematic-effectiveness-green-list-tab__map">
    <%= turbo_mount "Map", props: {
        servicesForPointQuery: @green_list_map[:point_query_services],
        popupAttributes: @green_list_map[:popup_attributes],
        title: @green_list_map[:title],
        overlays: @green_list_map[:overlays],
        disclaimer: @green_list_map[:disclaimer],
        type: @green_list_map[:type],
        autocompleteErrorMessages: map_yml[:autocomplete_error_messages],
        autocompletePlaceholder: map_yml[:autocomplete_placeholder]
    } %>
  </section>
  <div class="vw-thematic-effectiveness-green-list-tab__container--gap-3">
    <%= turbo_mount "StatsSites", props: {
          siteDetails: site_card_details(@example_greenlist),
          textViewAll: t('global.button.all'),
          title: t('thematic_area.green_list.card_text') + " (#{@greenlisted_pas_total_count})",
          viewAll: @green_list_view_all_url
      } %>
  </div>
</div>
