<section class="container">
  <div class="container--component">
    <h2><%= title %></h2>
    <div><%= content %></div>
    <div>

      <% charts.each_with_index do |chart, index| %>
        <% if chart[:title] %>
          <h3><%= chart[:title] %></h3>
        <% end %>

        <%= frontend_mount "ChartRowPa", key: index, props: {
              coverage: chart[:coverage],
              percent: chart[:total],
              theme: chart[:theme]
            } %>

        <% if chart[:legend] %>
          <ul class="chart--legend--horizontal">
            <% chart[:legend].each do |key| %>
              <li class="chart__legend-li">
                <span class="chart__legend-key <%= key[:theme] %>"></span>
                <span class="chart__legend-text"><%= key[:title] %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
