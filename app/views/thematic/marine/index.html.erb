<%= render partial: "./partials/bars/topbar-secondary", locals: { download_options: @download_options } %>
<div class="vw-thematic-marine">
  <%= render partial: "./layouts/partials/hero/marine", locals: {
      button_text: t('thematic_area.marine.hero.button_text'),
      button_url: @view_all_marine_pas_url,
      image: cms_fragment_render(:image, @cms_page),
      hero_small_text: cms_fragment_render(:hero_small_text, @cms_page),
      hero_small_text_url: cms_fragment_render(:hero_small_text_url, @cms_page),
      title: @cms_page.label,
      stats_items: @marine_stats_items,
      summary: cms_fragment_render(:summary, @cms_page) } %>
  <div class="vw-thematic-marine__container">
    <section class="vw-thematic-marine__medium vw-thematic-marine__wysiwyg">
      <h2>
        <%= t('thematic_area.marine.distribution.title') %>
      </h2>
      <div>
        <%= t('thematic_area.marine.distribution.content', total_ocean_pa_coverage_percentage: '%.2f' % marine_stats('total_ocean_pa_coverage_percentage'),
          national_waters_pa_coverage_percentage: '%.2f' % marine_stats('national_waters_pa_coverage_percentage'),
          high_seas_pa_coverage_percentage: '%.2f' % marine_stats('high_seas_pa_coverage_percentage')).html_safe %>
      </div>
    </section>
    <%= render partial: "partials/charts/total-coverage-chart", locals: {
        charts: [
          {
            title: t('thematic_area.marine.ocean.national-title'),
            charts_data: total_coverage_chart_national_data
          },
          {
            title: t('thematic_area.marine.ocean.high-title'),
            charts_data: total_coverage_chart_high_seas_data
          }
        ],
        content: cms_fragment_render(:section_ocean_content, @cms_page),
        title: cms_fragment_render(:section_ocean_title, @cms_page)
      } %>
    <%= render partial: "partials/charts/chart-coverage-growth", locals: {
        content: cms_fragment_render(:section_coverage_content, @cms_page),
        chart_data: @marine_protected_areas_growth,
        title: cms_fragment_render(:section_coverage_title, @cms_page) } %>
    <section class="vw-thematic-marine__medium vw-thematic-marine__wysiwyg">
      <h2>
        <%= cms_fragment_render(:section_bbnj_agreement_title, @cms_page) %>
      </h2>
      <div>
        <%= cms_fragment_render(:section_bbnj_agreement_content, @cms_page) %>
      </div>
    </section>
    <section class="vw-thematic-marine__medium vw-thematic-marine__wysiwyg">
      <h2>
        <%= cms_fragment_render(:section_beyond_coverage_title, @cms_page) %>
      </h2>
      <div>
        <%= cms_fragment_render(:section_beyond_coverage_content, @cms_page) %>
      </div>
    </section>
  </div>
  <div class="vw-thematic-marine__container--mpa">
    <%= render "partials/ctas/mpa-guide" %>
  </div>
  <section class="vw-thematic-marine__map">
    <%= frontend_mount "Map", props: {
    servicesForPointQuery: @map[:point_query_services],
    popupAttributes: @map[:popup_attributes],
    title: @map[:title],
    overlays: @map[:overlays],
    disclaimer: @map[:disclaimer],
    type: @map[:type],
    autocompleteErrorMessages: map_yml[:autocomplete_error_messages],
    autocompletePlaceholder: map_yml[:autocomplete_placeholder] } %>
  </section>
  <div class="vw-thematic-marine__container">
    <%= render partial: "partials/cards/sites", locals: {
    cards: @num_of_marine_protected_areas,
    title: "#{t('global.area-types.wdpca')} (#{@marine_total_pas_count})",
    url: @view_all_marine_pas_url
  } %>
  </div>
  <%= render "partials/carousels/themes" %>
  <%= render "partials/ctas/protected-planet-report" %>
</div>
