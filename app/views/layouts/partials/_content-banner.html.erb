<section
  class="content-banner content-banner--basic bg-image-overlay--white<%= ' content-banner--contained' if local_assigns[:contained] %> <%= page_type_class_name %>__content-banner <%= get_local_classes local_assigns %>"
  <% if local_assigns.has_key? :image %>
    style="background-image: url('<%= image %>')"
  <% end %>
>
  <div class="content-banner__container<%= ' container' unless local_assigns[:contained] %> <%= page_type_class_name %>__container">
    <div class="content-banner__content <%= page_type_class_name %>__content">
      <h2 class="content-banner__title"><%= title %></h2>

      <% if local_assigns.has_key? :summary %>
        <p class="content-banner__intro"><%= summary %></p>
      <% end %>

      <%= link_to button_text, button_url, title: button_text, class: 'button--primary' %>

      <% if (local_assigns.has_key? :hero_small_text) && (local_assigns.has_key? :hero_small_text_url) %>
        <%= link_to hero_small_text, hero_small_text_url, class: 'content-banner__small-text', title: 'hero_small_text' %>
      <% end %>
    </div>

    <% if local_assigns[:stats_items].present? %>
      <div class="content-banner__stats <%= page_type_class_name %>__stats">
        <div class="content-banner__stats-content bg--grey-black content-banner-stats <%= page_type_class_name %>__stats-content">
          <% stats_items.each do |stat_item| %>
            <div class="content-banner__stat-item <%= page_type_class_name %>__stat-item">
              <% small_number = stat_item[:small_number] == true %>
              <div class="<%= page_type_class_name + '__stat-number' %> <%= small_number ? 'content-banner__stat-number-small' : 'content-banner__stat-number' %>">
                <counter
                  :total="<%= stat_item[:total] %>"
                  trigger="content-banner-stats"
                  :decimal="<%= stat_item[:decimal] || 0 %>"
                ></counter><%= stat_item[:suffix].to_s.html_safe %>
              </div>
              <span class="content-banner__stat-text"><%= stat_item[:text] %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
