<div class="vw-partials-stats-stats-related-countries">
  <h2 class="vw-partials-stats-stats-related-countries__title"><%= t('stats.related-countries.title') %></h2>

  <% if country_children %>
    <ul class="vw-partials-stats-stats-related-countries__list">
      <% country_children.each do |child| %>
        <li class="vw-partials-stats-stats-related-countries__item">
          <span class="vw-partials-stats-stats-related-countries__item-title"><%= child['name'] %></span>
          <span class="vw-partials-stats-stats-related-countries__item-value"><%= child['iso_3'] %></span>
          <%= link_to 'View', country_path(child['iso_3']), title: '', class: 'vw-partials-stats-stats-related-countries__item-link' %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if country_parent %>
    <ul class="vw-partials-stats-stats-related-countries__list">
      <li class="vw-partials-stats-stats-related-countries__item">
        <span class="vw-partials-stats-stats-related-countries__item-title"><%= country_parent['name'] %></span>
        <span class="vw-partials-stats-stats-related-countries__item-value"><%= country_parent['iso_3'] %></span>
        <%= link_to 'View', country_path(country_parent['iso_3']), title: '', class: 'vw-partials-stats-stats-related-countries__item-link' %>
      </li>
    </ul>
  <% end %>
</div>
