<div class="vw-data-gdpame">
  <%= render partial: "./layouts/partials/hero/basic", locals: thematic_and_data_area_hero_locals(@cms_page) %>
  <%= render partial: 'partials/thematic_and_data_area/tabs', locals: {
    ga_id: "Slug: #{@cms_page.slug}",
    tabs_list: @tabs_list,
    tab_extras: [
      {
        tab_id: 1,
        partial: 'data_pages/gdpame/tab_content',
        replace_content: true,
        locals: {
          table_attributes: @table_attributes,
          filters: @filters,
          json: @json
        }
      }
    ]
  } %>
  <%= render "partials/ctas/protected-planet-report" %>
</div>
