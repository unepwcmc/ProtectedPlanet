<%= render partial: "./partials/bars/topbar-secondary", locals: { download_options: @download_options } %>

<%= render partial: "./layouts/partials/hero-area-types", locals: {
  button_search_text: cms_fragment_render("button-text"),
  button_search_url: @wdpca_view_all_url,
  image: cms_fragment_render(:image, @cms_page),
  hero_stat_text: t('thematic_area.wdpa.hero-stat-text'),
  hero_stat_percentage: @pa_coverage_percentage,
  classes: "#{@cms_page.slug} bg-image-overlay--white",
  summary: cms_fragment_render("summary"),
  title: @cms_page.label
} %>

<%= render partial: 'partials/thematic_and_data_area/tabs', locals: {
  ga_id: "Slug: #{@cms_page.slug}",
  tabs_list: @tabs_list,
  tab_extras: [
    {
      tab_id: 1,
      partial: 'data/wdpca/tab_extras',
      locals: {
        config_search: @config_search_areas,
        map: @map
      }
    }
  ]
} %>

<%= render "partials/thematic_and_data_area/footer" %>
