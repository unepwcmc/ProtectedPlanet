AWS_ACCESS_KEY_ID=key
AWS_SECRET_ACCESS_KEY=key
AWS_S3_REGION=xxxxx

# Slack Webhooks
# Incoming Webhook for general app notifications (bystander/exception notifier)
SLACK_WEBHOOK_URL=
# Incoming Webhook for portal release notifications
PP_SLACK_WEBHOOK_URL=

# Slack portal release verbosity controls
# Set to true to show array previews; otherwise only counts are shown
PP_RELEASE_SLACK_VERBOSE=false
# Maximum number of key=value parts included in a summary line
PP_RELEASE_SLACK_MAX_PARTS=40
# Number of array elements to preview when verbose is true
PP_RELEASE_SLACK_PREVIEW_COUNT=5

PP_HOST=localhost:3000
# Host the PDF generator's Chrome uses to reach the app directly, instead of
# piggybacking on PP_HOST. Falls back to PP_HOST when unset or blank.
#
# THE VALUE BELOW IS DEV-ONLY. `protectedplanet-web` is a docker-compose service
# name, resolvable only on the compose network - it is what lets the sidekiq
# container reach the web container without going back out through PP_HOST. Do NOT
# copy it into a Kamal env/secret: nothing resolves that name there, so every
# render fails on navigation and all PDF downloads break.
#
# Under Kamal, leave this unset and let the PP_HOST fallback do its thing - it
# hairpins out through kamal-proxy and back (measured at ~0.11s from the job
# container), which is not worth optimising away. config/deploy.staging.yml
# deliberately does not set it. If you ever do, it must be a host that actually
# resolves inside the job container.
PDF_RASTERIZER_HOST=protectedplanet-web:3000

# Port of the long-lived Chrome the PDF workers render in (docker/scripts/pdf-chrome,
# started by the sidekiq service in dev). It always runs next to the worker, so the
# port is the only part worth configuring, and both ends already default to 9222 -
# set this only to move them elsewhere, and set it for both. What decides whether
# the shared browser is used is simply whether pdf-chrome is running: production
# does not start it, so rasterize.js launches a private browser per job there. A
# browser costs ~440MB before it loads anything, so per-job launching is what makes
# a burst of PDF requests exhaust a small Docker VM.
# PDF_BROWSER_PORT=9222

# How long rasterize.js waits for window.__PDF_READY__ - the single budget for
# loading assets, mounting and rendering - and the hard ceiling on the whole node
# subprocess. Raise both together if you raise PDF_CONCURRENCY. docker-compose.yml
# raises both well above these defaults for local dev, where every module is
# compiled on demand by the Vite dev server rather than served precompiled.
# PDF_READY_TIMEOUT_MS=90000
# PDF_RASTERIZE_TIMEOUT_SECONDS=240
# Bounds fetching the page's HTML only, not its assets, so it rarely needs raising.
# PDF_NAVIGATION_TIMEOUT_MS=60000
xpack.security.enabled=XXXX
discovery.type=XXXX

MAPBOX_ACCESS_TOKEN=key
MAPBOX_STATIC_IMAGE_URL=xxxxxxxxx


# comfortable_mexican_sofa credentials
COMFY_ADMIN_USERNAME=username
COMFY_ADMIN_PASSWORD=password