<section class="spacer-large--bottom">
  <%= render partial: "partials/search/protected-areas", locals: { config: config_search } %>
</section>

<section class="map-section">
  <%= frontend_mount "Map", props: {
    options: local_assigns[:map_options] || {},
    servicesForPointQuery: map[:point_query_services],
    popupAttributes: map[:popup_attributes],
    title: map[:title],
    overlays: map[:overlays],
    disclaimer: map[:disclaimer],
    type: map[:type],
    autocompleteErrorMessages: map_yml[:autocomplete_error_messages],
    autocompletePlaceholder: map_yml[:autocomplete_placeholder]
  } %>
</section>
