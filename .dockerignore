.git*
log/
tmp/
Dockerfile
README.md
.env*
docker-compose.yml

# Large dirs that must NOT be sent as build context — they are either
# regenerated in the image (node_modules via `yarn install`) or volume-mounted
# at runtime (node_modules, chrome). Sending them made the context ~6.3 GB and
# stalled builds.
node_modules/
chrome/
# Puppeteer's browser cache (~650MB). The image downloads its own Linux Chrome into
# /app/.cache/puppeteer during `yarn install`; sending a local copy would both bloat
# the context and let `COPY . .` overwrite the image's browser with the host's.
.cache/

# ActiveStorage runtime uploads — never needed at build time
storage/

# Build artifacts (regenerated; also gitignored)
public/vite-dev/
public/vite-test/
public/vite/
public/assets/
coverage/
