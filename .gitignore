.DS_Store
*.un~

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal
/db/structure.sql

# Ignore all logfiles and tempfiles.
# Match rotated logs too (test.log.0, production.log.1, ...): the bare *.log
# pattern missed them, which is how a 246MB log/test.log.0 got committed once.
/log/*.log*

/tmp/*
!/tmp/.gitkeep

dump.rdb

/coverage
/public/assets
.env

coverage
node_modules
/public/vite-dev
/public/vite-test
/public/vite
/public/system
/storage
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity
.byebug_history

vendor/bundle
/public/manifests
/chrome
.yarn/install-state.gz
/.serena
