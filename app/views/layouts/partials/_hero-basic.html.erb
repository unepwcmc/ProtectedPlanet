<% if local_assigns[:image].present? %>
  <header class="vw-hero-basic" style="background-image: url('<%= image %>')">
<% else %>
  <header class="vw-hero-basic">
<% end %>

  <div class="vw-hero-basic__container <%= 'vw-hero-basic__container--centre-text' if local_assigns[:centre_text] %>">
    <h1 class="vw-hero-basic__title"><%= title %></h1>
    <% if local_assigns[:summary].present? %>
      <p class="vw-hero-basic__intro"><%= summary %></p>
    <% end %>
    <% if local_assigns[:button_link].present? && local_assigns[:button_text].present? %>
      <%= link_to button_text, button_link, target: '_blank', title: t('global.links.visit', link: button_link), class: 'button--external' %>
    <% end %> 
  </div>
</header>