<% get_all = false if local_assigns[:get_all].nil? %>
<% get_news_items get_all %>
<div class="vw-partials-cards-news">
  <% unless get_all %>
    <div class="vw-partials-cards-news__header">
      <h2 class="vw-partials-cards-news__title">
        <%= @items[:title] %>
      </h2>
      <%= link_to @items[:url], title: t('global.button.all'), class: 'vw-partials-cards-news__all' do %>
        <%= t('global.button.all') %>
        <i class="vw-partials-cards-news__all-icon"></i>
      <% end %>
    </div>
  <% end %>
  <%= frontend_mount "ListingPageCardNews", props: {
        cards: @items[:cards].map do |card|
          {
            date: cms_fragment_content_datetime(:published_date, card).strftime('%d %B %y'),
            image: cms_fragment_render(:image, card),
            summary: cms_fragment_content(:summary, card),
            title: card[:label].truncate(59, separator: ' '),
            url: card[:full_path]
          }
        end
      } %>
</div>