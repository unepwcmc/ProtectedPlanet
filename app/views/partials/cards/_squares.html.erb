<div class="vw-partials-cards-squares">
  <div class="vw-partials-cards-squares__sqaures">
    <% cards.each do |card| %>
      <%= link_to card[:url],
      title: "Explore Protected Areas by #{card[:title]}",
      class: 'vw-partials-cards-squares__card',
      style: "background-image: url('#{card[:image]}')" do %>
        <div class="vw-partials-cards-squares__overlay"></div>
        <h3 class="vw-partials-cards-squares__title">
          <%= card[:title] %>
        </h3>
        <i class="vw-partials-cards-squares__chevron"></i>
      <% end %>
    <% end %>
  </div>
  <%= link_to @pas_button, @pas_link, title: @pas_button, class: 'vw-partials-cards-squares__button' %>
</div>
