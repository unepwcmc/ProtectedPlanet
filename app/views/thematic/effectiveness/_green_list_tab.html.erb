<div class="container spacer-small--top">
  <%= render partial: "./layouts/partials/content-banner", locals: green_list_banner_locals(@cms_page) %>
</div>

<section class="container--medium spacer-small--top">
  <h2><%= cms_fragment_render(:green_list_about_title, @cms_page) %></h2>
  <div><%= cms_fragment_render(:green_list_about_content, @cms_page) %></div>
</section>

<%= render partial: "partials/charts/chart-row-pa", locals: {
  charts: [
    {
      coverage: @greenlisted_pas_percent,
      legend: chart_row_pa_legend,
      theme: 'theme--blue',
      total: @global_oecms_pas_coverage_percentage
    }
  ],
  title: cms_fragment_render(:green_list_percentage_chart_title, @cms_page),
  content: cms_fragment_render(:green_list_percentage_chart_description, @cms_page)
} %>

<section class="map-section">
  <%= frontend_mount "Map", props: {
    servicesForPointQuery: @green_list_map[:point_query_services],
    popupAttributes: @green_list_map[:popup_attributes],
    title: @green_list_map[:title],
    overlays: @green_list_map[:overlays],
    disclaimer: @green_list_map[:disclaimer],
    type: @green_list_map[:type],
    autocompleteErrorMessages: map_yml[:autocomplete_error_messages],
    autocompletePlaceholder: map_yml[:autocomplete_placeholder]
  } %>
</section>

<section class="container spacer-large--top">
  <%= cms_fragment_render("content") %>
  <%= render partial: "partials/cards/sites", locals: {
    cards: @example_greenlist,
    title: t('thematic_area.green_list.card_text') + " (#{@greenlisted_pas_total_count})",
    url: @green_list_view_all_url
  } %>
</section>
