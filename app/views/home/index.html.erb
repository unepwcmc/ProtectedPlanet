<%= render partial: "./layouts/partials/hero-home", locals: {
    button: t('home.hero.button')
  }
%>

<section class="container spacer-small--top">
  <%= render partial: "partials/cards/facts", locals: { cards: @site_facts } %>
  <p class="p-larger no-margin--top">
    <span class="bold">
      <%= t('home.download.label') %>: 
    </span>
    
    <%= @update_date %>

    <%= frontend_mount "GaLink",
          tag: :span,
          class: "margin-space--left",
          props: {
            gaId: "Download global statistics",
            href: global_statistics_download_path,
            text: t('home.download.link')
          } %>
  </p>
</section>

<%= render partial: "partials/search/protected-areas", locals: { config: @config_search_areas } %>

<section class="container spacer-small--top">
  <h2 class="text-center"><%= @pas_title %></h2>

  <%= render partial: "partials/cards/circles", locals: { cards: @pas_levels } %>

  <%= render partial: "partials/cards/squares", locals: { cards: pas_categories } %>
</section>

<section class="map-section spacer-small--top">
  <%= frontend_mount "Map", props: {
    servicesForPointQuery: @main_map[:point_query_services],
    popupAttributes: @main_map[:popup_attributes],
    title: @main_map[:title],
    overlays: @main_map[:overlays],
    disclaimer: @main_map[:disclaimer]
  } %>
</section>

<section class="spacer-small--top">
  <%= render "partials/carousels/themes" %>
</section>

<%= render "partials/ctas/api" %>

<section class="container spacer-medium--top">
  <%= render "partials/cards/resources" %>
</section>

<section class="container spacer-medium--bottom">
  <%= render "partials/cards/news" %>
</section>

<%= render "partials/ctas/live-report" %>
