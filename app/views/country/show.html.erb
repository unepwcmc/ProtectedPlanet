<%= render partial: "./partials/bars/topbar-secondary", locals: { 
  download_options: @download_options,
  download_disabled: @total_wdpa == 0
} %>
<div class="vw-country">
  <div class="vw-country__container">
    <% if (restricted_message = get_restricted_message) %>
      <div class="vw-country__restricted-message">
        <p>
          <%= restricted_message %>
        </p>
      </div> 
    <% end %>
    <section class="vw-country__overview">
      <%= render partial: "partials/stats/stats-overview-country", locals: { 
        flag: @flag_path,
        chart_point_poly: @country_presenter.chart_point_poly,
        legend_map: map_legend,
        title: @country.name,
        total_oecm: @total_oecm,
        total_pame: @total_pame,
        total_wdpa: @total_wdpa,
        wdpa_national_designations_count: @wdpa_national_designations_count,
        oecm_national_designations_count: @oecm_national_designations_count
      } %>
      <%= frontend_mount "Map", props: {
          options: @map_options,
          servicesForPointQuery: @map[:point_query_services],
          popupAttributes: @map[:popup_attributes],
          title: @map[:title],
          overlays: @map[:overlays],
          disclaimer: @map[:disclaimer],
          isHidden: true,
          showHeader: false
        } %>
    </section>
    <section>
      <%= frontend_mount "RegionCountryPages", props: {
          data: @stats_data,
          tabs: @tabs,
          gaId: "Country page stats",
          relatedCountriesHtml: has_related_countries? ? render(partial: "partials/stats/stats-related-countries", locals: {
            country_children: @country.children.any? ? @country.children : nil,
            country_parent: @country.parent.present? ? @country.parent : nil
          }) : nil
        } %>
    </section>
    <%= render partial: "partials/messages/message-citation", locals: { title: @country.name } %>
  </div>
</div>
