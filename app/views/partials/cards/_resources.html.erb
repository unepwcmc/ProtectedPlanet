<% get_all = false if local_assigns[:get_all].nil? %>
<% get_resource_cards get_all %>
<div class="vw-partials-cards-resources">
  <div class="vw-partials-cards-resources__header">
    <h2 class="vw-partials-cards-resources__title">
      <%= @items[:title] %>
    </h2>
    <% if @items[:url] && !get_all %>
      <%= link_to @items[:url], title: t('global.button.all'), class: 'vw-partials-cards-resources__all' do %>
        <%= t('global.button.all') %>
        <i class="vw-partials-cards-resources__all-icon"></i>
      <% end %>
    <% end %>
  </div>
  <%= turbo_mount "ListingPageCardResources", props: {
        cards: @items[:cards].map do |card|
          {
            date: card[:date],
            fileUrl: card[:fileUrl],
            linkTitle: card[:linkTitle],
            linkUrl: card[:linkUrl],
            summary: card[:summary],
            title: card[:title],
            url: card[:url]
          }
        end,
        preview: !get_all
      } %>
</div>
