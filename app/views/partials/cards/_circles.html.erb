<div class="vw-partials-cards-circles">
  <h2 class="vw-partials-cards-circles__title">
    <%= title %>
  </h2>
  <div class="vw-partials-cards-circles__circles">
    <% cards.each do |card| %>
      <%= link_to card[:url], title: "Explore Protected Areas by #{card[:title]}", class: 'vw-partials-cards-circles__card' do %>
        <i class="vw-partials-cards-circles__icon--<%= card[:icon] %>"></i>
        <h3 class="vw-partials-cards-circles__card-title">
          <%= card[:title] %>
        </h3>
        <i class="vw-partials-cards-circles__chevron"></i>
      <% end %>
    <% end %>
  </div>
</div>