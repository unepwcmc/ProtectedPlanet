<%= render partial: "./layouts/partials/hero-small", locals: {
  title: t('search.search-areas-title')
} %>

<%= frontend_mount "SearchAreas", props: {
  configAutocomplete: @config_search_areas,
  downloadButtonText: t('global.button.download'),
  downloadOptions: @download_options,
  downloadTextCommercial: @download_text[:commercial],
  endpointAutocomplete: search_autocomplete_path,
  endpointSearch: search_areas_results_path(filters: @filters),
  filterGroups: @filter_groups,
  gaId: 'Component: search areas',
  noResultsText: t('search.no-results'),
  results: @results,
  smTriggerElement: 'sm-trigger-infinite-scroll',
  tabs: @tabs,
  textClear: t('search.clear'),
  textClose: 'View Results',
  textFilters: t('search.filters')
} %>