# Secret NAMES only — committed, safe for git. Values come from the environment
# at deploy time. No registry credentials: the image is built on the deploy host.

# Rails
SECRET_KEY_BASE=$SECRET_KEY_BASE

# Database — sept19_from_production on the Proxmox staging DB host.
# Shared with protectedplanet-api; the two cannot diverge on DB/PostGIS version.
POSTGRES_HOST=$POSTGRES_HOST
POSTGRES_PORT=$POSTGRES_PORT
POSTGRES_DBNAME=$POSTGRES_DBNAME
POSTGRES_USER=$POSTGRES_USER
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Search / cache / queues — all host-local on the web VM
ELASTIC_SEARCH_URL=$ELASTIC_SEARCH_URL
REDIS_URL=$REDIS_URL

# CMS admin (Comfortable Mexican Sofa)
COMFY_ADMIN_USERNAME=$COMFY_ADMIN_USERNAME
COMFY_ADMIN_PASSWORD=$COMFY_ADMIN_PASSWORD

# Object storage (ActiveStorage is already S3 — no upload volume needed)
AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
AWS_S3_REGION=$AWS_S3_REGION
# aws-sdk reads AWS_REGION, not AWS_S3_REGION, and raises at boot without it.
AWS_REGION=$AWS_REGION

# Mail
MAILER_ADDRESS=$MAILER_ADDRESS
MAILER_PORT=$MAILER_PORT
MAILER_DOMAIN=$MAILER_DOMAIN
MAILER_USERNAME=$MAILER_USERNAME
MAILER_PASSWORD=$MAILER_PASSWORD
MAILER_HOST=$MAILER_HOST
MAILER_ASSET_HOST=$MAILER_ASSET_HOST

# Third-party
MAPBOX_ACCESS_TOKEN=$MAPBOX_ACCESS_TOKEN
# Base URL for the Mapbox Static Images API, used SERVER-side by
# AssetGenerator.mapbox_url (app_secrets mapbox.base_url). Separate from the token
# above, which is also a build secret because Vite inlines it into the client
# bundle. Missing here until Aug 2026, so it was unset on staging and
# `base_url + "geojson(...)"` raised NoMethodError on nil — every
# /assets/tiles/:id 500'd, taking out the map overlay and the search-result
# thumbnails.
MAPBOX_STATIC_IMAGE_URL=$MAPBOX_STATIC_IMAGE_URL
CARTODB_API_KEY=$CARTODB_API_KEY
APPSIGNAL_PUSH_API_KEY=$APPSIGNAL_PUSH_API_KEY
SLACK_WEBHOOK_URL=$SLACK_WEBHOOK_URL
# PP_SLACK_WEBHOOK_URL deliberately keeps its prefix: it is a DIFFERENT webhook
# from SLACK_WEBHOOK_URL above. SLACK_WEBHOOK_URL drives exception_notification
# and Bystander; PP_SLACK_WEBHOOK_URL drives PortalRelease::Notifier. Renaming
# would collide and silently merge two notification streams.
PP_SLACK_WEBHOOK_URL=$PP_SLACK_WEBHOOK_URL
MAINTENANCE_MODE_KEY=$MAINTENANCE_MODE_KEY

# TLS for kamal-proxy — *.internal.unep-wcmc.org wildcard
CERTIFICATE_PEM=$CERTIFICATE_PEM
PRIVATE_KEY_PEM=$PRIVATE_KEY_PEM
